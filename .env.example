# LawnBerry Pi environment configuration (example)
# Copy to .env and fill in your values.

# Optional: additional domains (comma-separated)
ALT_DOMAINS=
# Optional: Cloudflare token for DNS-01 challenges (Zone:DNS:Edit on your zone)
CLOUDFLARE_API_TOKEN=
# Primary domain used for HTTPS certificates
LB_DOMAIN=example.com
# Contact email for Let's Encrypt registration and expiry notices
LETSENCRYPT_EMAIL=you@example.com

# Local service ports
BACKEND_PORT=8081
FRONTEND_PORT=3000

# --- RTK / NTRIP corrections -------------------------------------------------
# Required when gps_ntrip_enabled=true so the backend can stream RTCM data
# from a caster to the ZED-F9P receiver.
NTRIP_HOST=
NTRIP_MOUNTPOINT=
NTRIP_PASSWORD=
NTRIP_PORT=
NTRIP_USERNAME=

# Serial link to the rover GPS.
# LC29H uses /dev/ttyAMA0 at 115200 baud (UART)
# ZED-F9P uses /dev/ttyACM0 or /dev/ttyACM1 (USB)
NTRIP_SERIAL_BAUD=115200
NTRIP_SERIAL_DEVICE=/dev/ttyAMA0

# Optional: Provide a static GGA sentence when the rover is stationary.
NTRIP_GGA_ALT=
NTRIP_GGA_INTERVAL=
NTRIP_GGA_LAT=
NTRIP_GGA_LON=

# --- ACME / TLS (certbot-backed) --------------------------------------------
# Use the Let's Encrypt staging environment (1) until you are ready to issue a
# real certificate (0). Staging avoids production rate limits.
ACME_STAGING=1
# Webroot served on port 80 whose /.well-known/acme-challenge/ answers HTTP-01.
ACME_WEBROOT=/var/www
# certbot config/account/live state directory.
ACME_LE_DIR=/etc/letsencrypt
# Path to the certbot binary (auto-detected if unset).
# ACME_CERTBOT_BIN=/usr/bin/certbot

# --- Operator authentication ------------------------------------------------
# systemd/install_services.sh provisions both values in the real .env (mode 0600) and
# refuses to finish without a usable credential. Neither has a built-in default.
# LAWN_BERRY_OPERATOR_CREDENTIAL: the one shared operator password (the web UI login form's
# password; the username is ignored). At least 12 characters, not a known default. Wrap it in
# single quotes if it has spaces; it cannot contain ' or \.
# LAWN_BERRY_AUTH_SECRET: signs operator tokens. Leave it empty here: the installer generates
# a 64-hex-character secret once and keeps it, so sessions survive a backend restart.
LAWN_BERRY_OPERATOR_CREDENTIAL=
LAWN_BERRY_AUTH_SECRET=
# OPERATOR_AUTH_REQUIRED: the unit sets 1. Only 0/false/no/off disable operator authentication
# (anything else, including an empty value, keeps it on). A value here OVERRIDES the unit, and
# the backend logs CRITICAL at every start while it is off outside SIM_MODE.
# OPERATOR_AUTH_REQUIRED=1
# MANUAL_CONTROL_PASSWORD: optional dedicated password for the Control view's step-up unlock
# (default: the operator credential). The unlock also needs the login's bearer token.
# MANUAL_CONTROL_PASSWORD=
# Simulator only (needs SIM_MODE=1, never honoured when LAWNBERRY_ENV=production): accept any
# non-empty login credential and any WebSocket client. SIM_MODE alone no longer does.
# LAWN_BERRY_SIM_OPEN_AUTH=1

# --- Auth hardening ---------------------------------------------------------
# Login attempt rate limit (per TCP peer address, not X-Client-Id) and failed-attempt lockout.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW=60
AUTH_LOCKOUT_FAILURES=5
AUTH_LOCKOUT_SECONDS=30

# --- Google OAuth (optional) ------------------------------------------------
# When Google OAuth is enabled, google-auth must be installed and the token is
# verified server-side (login fails closed if verification is unavailable).

# --- Paths (override on-device) ---------------------------------------------
# LAWNBERRY_DATA_DIR=/apps/lawnberry-pi/data
# LAWNBERRY_DOCS_DIR=/apps/lawnberry-pi/docs

# --- Thor training-data sync (Pi side) --------------------------------------
# When enabled, the Pi auto-queues each finished recording session for upload to
# the Thor training server's receiver (mower/scripts/thor_upload_receiver.py).
# Point THOR_BASE_URL at Thor's LAN address + the receiver's port.
THOR_UPLOAD_ENABLED=0
THOR_BASE_URL=http://192.168.1.64:15454
THOR_API_KEY=
