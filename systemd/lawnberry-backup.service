[Unit]
Description=LawnBerry Pi - Automated Backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@LB_USER@
Group=@LB_GROUP@
WorkingDirectory=@LB_ROOT@
ExecStart=@LB_ROOT@/scripts/backup_system.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
